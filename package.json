{
  "name": "portafolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "next build && node scripts/resolver-suspense.mjs",
    "start": "npx --yes serve@14 out -l 3210",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"pruebas/**/*.test.mjs\"",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run privacidad && npm run demo-limpia",
    "privacidad": "node scripts/privacidad.mjs out",
    "demo-limpia": "node scripts/demo-limpia.mjs",
    "demo:crm": "npm --prefix demos/crm ci && npm --prefix demos/crm run build"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.1",
    "lenis": "^1.3.28",
    "marked": "^18.3.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "playwright": "1.63.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3"
  }
}
